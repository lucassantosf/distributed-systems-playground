{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "grafana-opensearch-datasource", "name": "OpenSearch", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Dashboard de Observabilidade para o Projeto 05 — Event Streaming Platform (Card 18)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Visão Geral — Event Streaming Platform",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Total acumulado de pedidos criados pelo producer-api",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum(orders_created_total) or vector(0)",
          "legendFormat": "Pedidos Criados",
          "refId": "A"
        }
      ],
      "title": "Pedidos Criados",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Total acumulado de eventos publicados no Kafka com sucesso",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum(kafka_events_published_total{status=\"success\"}) or vector(0)",
          "legendFormat": "Eventos Publicados",
          "refId": "A"
        }
      ],
      "title": "Eventos Publicados (Kafka)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Taxa atual de erros de publicação no Kafka",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum(kafka_events_published_total{status=\"error\"}) or vector(0)",
          "legendFormat": "Falhas Kafka",
          "refId": "A"
        }
      ],
      "title": "Falhas de Publicação Kafka",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Taxa de requisições HTTP recebidas por segundo",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 13,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum(rate(http_requests_total{job=\"producer-api\"}[1m])) or vector(0)",
          "legendFormat": "Req/s HTTP",
          "refId": "A"
        }
      ],
      "title": "Taxa HTTP (Req/s)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Métricas de Performance & Tráfego",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Taxa de requisições HTTP recebidas por método, endpoint e status",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum by (endpoint, status) (rate(http_requests_total{job=\"producer-api\"}[1m]))",
          "legendFormat": "{{endpoint}} [{{status}}]",
          "refId": "A"
        }
      ],
      "title": "Taxa de Requisições HTTP (producer-api)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Taxa de eventos publicados no Kafka por tópico e status",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum by (topic, status) (rate(kafka_events_published_total{job=\"producer-api\"}[1m]))",
          "legendFormat": "Tópico: {{topic}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Taxa de Publicação Kafka (events/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Latência P95 e P99 de publicação de eventos no Kafka",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kafka_publish_duration_seconds_bucket[1m])))",
          "legendFormat": "P95 Latência Publicação",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kafka_publish_duration_seconds_bucket[1m])))",
          "legendFormat": "P99 Latência Publicação",
          "refId": "B"
        }
      ],
      "title": "Latência de Publicação Kafka (P95 & P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "description": "Percentual de erros em requisições HTTP do producer-api",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "(sum(rate(http_requests_total{job=\"producer-api\", status=~\"5.*|4.*\"}[1m])) / sum(rate(http_requests_total{job=\"producer-api\"}[1m]))) * 100 or vector(0)",
          "legendFormat": "% Erros HTTP",
          "refId": "A"
        }
      ],
      "title": "Taxa de Erro HTTP (%)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Producer API Logs Estruturados",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "description": "Logs estruturados do producer-api (Projeto 05) com trace_id",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "service:producer-api",
          "refId": "A",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "logs", "settings": { "limit": "200" } }]
        }
      ],
      "title": "Logs Recentes — producer-api",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["observability", "project-05", "kafka", "producer-api"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Projeto 05 — Event Streaming Platform",
  "uid": "project-05-event-streaming",
  "version": 2
}
