{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "grafana-opensearch-datasource", "name": "OpenSearch", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Logs estruturados da sample-app: volume por nível, logs recentes e erros críticos (Card 11)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Volume de Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "description": "Volume de logs por nível ao longo do tempo — identifica picos de WARN/ERROR",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "INFO" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "DEBUG" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#6E9FCA", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "WARNING" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F5A623", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "ERROR" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E02F44", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "level:DEBUG",
          "alias": "DEBUG",
          "refId": "A",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "settings": {
                "field": "@timestamp",
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        },
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "level:INFO",
          "alias": "INFO",
          "refId": "B",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "settings": {
                "field": "@timestamp",
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        },
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "level:WARNING",
          "alias": "WARNING",
          "refId": "C",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "settings": {
                "field": "@timestamp",
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        },
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "level:ERROR",
          "alias": "ERROR",
          "refId": "D",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "settings": {
                "field": "@timestamp",
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        }
      ],
      "title": "Volume de Logs por Nível",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "title": "Logs Recentes",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "description": "Stream de todos os logs recentes com timestamp, nível, serviço, mensagem e trace_id",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 11 },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false,
        "dataLinks": [
          {
            "field": "trace_id",
            "title": "🔍 Abrir trace no Tempo",
            "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"queryType\":\"traceId\",\"query\":\"${__value.raw}\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"}}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}",
            "targetBlank": true
          }
        ]
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "",
          "refId": "A",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "logs", "settings": { "limit": "500" } }],
          "bucketAggs": []
        }
      ],
      "title": "Logs Recentes — Todos os Níveis",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 102,
      "title": "Erros Críticos",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "description": "Contador de erros nas últimas horas — deve ser zero em condições normais",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "options": { "0": { "text": "✅ Sem erros", "color": "green" } } }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 24 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "level:ERROR",
          "refId": "A",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "settings": {
                "field": "@timestamp",
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "title": "Total de ERRORs (janela selecionada)",
      "type": "stat"
    },
    {
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "description": "Apenas logs de nível ERROR — para investigação rápida de falhas críticas. Cada entrada contém o trace_id para correlação.",
      "gridPos": { "h": 12, "w": 20, "x": 4, "y": 24 },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "dataLinks": [
          {
            "field": "trace_id",
            "title": "🔍 Abrir trace no Tempo",
            "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"queryType\":\"traceId\",\"query\":\"${__value.raw}\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"}}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}",
            "targetBlank": true
          }
        ]
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "level:ERROR",
          "refId": "A",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "logs", "settings": { "limit": "200" } }],
          "bucketAggs": []
        }
      ],
      "title": "⚠️ Erros Críticos (level:ERROR)",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["observability", "sample-app", "logs"],
