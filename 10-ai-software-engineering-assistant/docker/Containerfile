FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Roda as migrations antes de iniciar o servidor.
# O volume do docker-compose monta o código local em /app,
# então o alembic sempre usa as migrations mais recentes.
CMD ["sh", "-c", "alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload"]
